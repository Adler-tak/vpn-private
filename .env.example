# =====================================================================
# VPN Private — Production Core Environment (3-to-97 Rule)
# =====================================================================
# In accordance with the 3-to-97 architecture rule:
# Only the 3% fundamental infrastructure secrets and bootstrap connections
# are stored in this .env file.
#
# The remaining 97% of application settings (bank cards, crypto wallets,
# payment gateways, bot texts, trial plans, commission rates, and admin
# panel credentials) are stored securely in the PostgreSQL database
# (table: system_settings) and managed via the Web Admin Panel.
# =====================================================================

# Application Identity & Mode
PROJECT_NAME="VPN Private"
ENVIRONMENT=production
DEBUG=false

# Core Security Keys (Generate strong 64-char hex & Fernet keys)
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-generated-64-character-hex-secret-key-in-production
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-base64-key-in-production
API_V1_STR=/api/v1
SERVER_HOST=https://api.yourdomain.com

# Telegram Bot Initial Token & Admins
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=VPNPrivateSell_Bot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database (PostgreSQL 16 for Docker / SQLite for local)
POSTGRES_USER=vpn_user
POSTGRES_PASSWORD=vpn_super_secure_production_password_2026
POSTGRES_DB=vpn_private
DATABASE_URL=postgresql+asyncpg://vpn_user:vpn_super_secure_production_password_2026@vpnprivate-postgres:5432/vpn_private
DATABASE_URL_SYNC=postgresql://vpn_user:vpn_super_secure_production_password_2026@vpnprivate-postgres:5432/vpn_private
# For local SQLite development:
# DATABASE_URL=sqlite+aiosqlite:///vpn_private.db
# DATABASE_URL_SYNC=sqlite:///vpn_private.db

# Redis (Cache, Sessions, Distributed Locks, Celery)
REDIS_URL=redis://vpnprivate-redis:6379/0
CELERY_BROKER_URL=redis://vpnprivate-redis:6379/1
CELERY_RESULT_BACKEND=redis://vpnprivate-redis:6379/2
